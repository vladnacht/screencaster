{
  "name": "screencaster",
  "version": "0.3.0",
  "description": "Lightweight demo videos (MP4/MKV, never over 10 MB) and screenshots of a web feature or a Chrome tab, from a plain description, driven by subagents: target, script, capture, review.",
  "author": {
    "name": "Kamal NASSIROU",
    "email": "vladnacht@gmail.com"
  },
  "homepage": "https://github.com/vladnacht/screencaster#readme",
  "repository": "https://github.com/vladnacht/screencaster",
  "license": "MIT",
  "keywords": [
    "demo",
    "video",
    "screenshot",
    "playwright",
    "screencast",
    "mcp"
  ],
  "mcpServers": {
    "demo-capture": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/demo-capture/launch.mjs"
      ]
    }
  }
}
