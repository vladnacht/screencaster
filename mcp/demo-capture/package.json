{
  "name": "demo-capture",
  "version": "0.3.0",
  "description": "MCP server: drive a browser tab, record it to a lightweight MP4/MKV, take screenshots.",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "bin": { "demo-capture": "dist/server.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
